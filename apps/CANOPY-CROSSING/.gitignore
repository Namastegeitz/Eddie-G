# Godot cache / build output
.godot/
build/
*.tmp

# Builds live in BUILDS/<platform>/ (each platform its own folder). The game
# files are too big for git: only each folder's README.md and BUILD_INFO.json
# are kept; GitHub Actions (canopy-crossing-release.yml) rebuilds them all.
BUILDS/*/*
!BUILDS/*/README.md
!BUILDS/*/BUILD_INFO.json

# Godot installs its Android Gradle build template here when building the Play Store .aab
/android/
# Crashlytics library: built by tools/build_crashlytics.sh (CI), never committed
addons/canopy_crashlytics/bin/
android_plugins/**/build/
android_plugins/**/.gradle/
android_plugins/**/local.properties
android_plugins/crashlytics/plugin/src/main/res/
# Firebase / Sentry config files stay out of git (GitHub secrets)
google-services.json
GoogleService-Info.plist
# Sentry SDK: installed by tools/install_sentry.sh on the build machine, never committed
addons/sentry/
