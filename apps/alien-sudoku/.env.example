# Copy to .env (never commit .env) and fill in your AdMob AD UNIT ids.
# Leave a line empty to keep Google's public test unit for it.
# App ids (with "~") go in the native projects: see tools/set-admob-ids.mjs.
VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=
VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=
