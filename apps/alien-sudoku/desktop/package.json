{
  "name": "alien-sudoku-desktop",
  "productName": "Alien Sudoku",
  "version": "1.0.0",
  "description": "Alien Sudoku for Windows, macOS and Linux.",
  "author": "Eddie G",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "copy-web": "node copy-web.cjs",
    "start": "npm run copy-web && electron .",
    "smoke": "npm run copy-web && electron . --smoke-test",
    "dist": "npm run copy-web && electron-builder --publish never",
    "dist:win": "npm run copy-web && electron-builder --win --publish never",
    "dist:mac": "npm run copy-web && electron-builder --mac --publish never",
    "dist:linux": "npm run copy-web && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.eddieg.aliensudoku",
    "productName": "Alien Sudoku",
    "copyright": "Copyright \u00a9 2026 Eddie G",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "package.json"
    ],
    "artifactName": "AlienSudoku-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "AlienSudoku-${version}-win-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Alien Sudoku"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.puzzle-games",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "Eddie G <noreply@example.com>",
      "synopsis": "Sudoku with alien glyphs"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "publish": null
  },
  "homepage": "https://github.com/Namastegeitz/Eddie-G"
}
