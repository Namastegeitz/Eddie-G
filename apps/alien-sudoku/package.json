{
  "name": "alien-sudoku",
  "private": true,
  "version": "1.0.0",
  "description": "Alien Sudoku - decode the glyphs of the lost UFO archive. Web, iOS, Android and desktop.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:puzzles": "node tools/gen-puzzles.mjs",
    "gen:icons": "node tools/gen-icons.mjs",
    "cap:sync": "npm run build && cap sync",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run cap:sync && cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
