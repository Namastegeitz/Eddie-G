; Engine configuration file.
; Cosmic Saucer Drift — arcade UFO kart racing.

config_version=5

[application]

config/name="Cosmic Saucer Drift"
config/description="Arcade UFO kart racing: drift, boost, keep your Dark Matter core charged."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.02, 0.08, 1)
config/icon="res://icon.svg"

[autoload]

Save="*res://autoload/save.gd"
InputRouter="*res://autoload/input_router.gd"
Events="*res://autoload/events.gd"
Ads="*res://autoload/ads.gd"
Store="*res://autoload/store.gd"
Audio="*res://autoload/audio.gd"
Game="*res://autoload/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor]

export/convert_text_resources_to_binary=false

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="ground"
3d_physics/layer_2="walls"
3d_physics/layer_3="racers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.02, 0.01, 0.05, 1)
