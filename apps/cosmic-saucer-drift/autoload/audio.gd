extends Node
## Sound effects and music. Sounds live in assets/audio/*.wav (generated by
## tools/gen_audio.py); any missing file is skipped silently.
## Buses: Master > Music, SFX.

const DIR := "res://assets/audio/"
var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _pool3d: Array[AudioStreamPlayer3D] = []
var _music: AudioStreamPlayer
var _music_name := ""
var _next := 0
var _next3d := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	if AudioServer.get_bus_index("Music") < 0:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.bus_count - 1, "Music")
		AudioServer.set_bus_send(AudioServer.bus_count - 1, "Master")
	if AudioServer.get_bus_index("SFX") < 0:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.bus_count - 1, "SFX")
		AudioServer.set_bus_send(AudioServer.bus_count - 1, "Master")
	for i in 14:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in 10:
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.max_distance = 90.0
		p.unit_size = 12.0
		add_child(p)
		_pool3d.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	apply_volumes()


func apply_volumes() -> void:
	_set_bus("Master", Save.setting("master"))
	_set_bus("Music", Save.setting("music"))
	_set_bus("SFX", Save.setting("sfx"))


func _set_bus(bus: String, v: float) -> void:
	var i := AudioServer.get_bus_index(bus)
	if i >= 0:
		AudioServer.set_bus_volume_db(i, linear_to_db(maxf(v, 0.0001)))
		AudioServer.set_bus_mute(i, v <= 0.001)


func stream(sound: String) -> AudioStream:
	if _streams.has(sound):
		return _streams[sound]
	var path := DIR + sound + ".wav"
	var s: AudioStream = load(path) if ResourceLoader.exists(path) else null
	_streams[sound] = s
	return s


func play(sound: String, vol_db := 0.0, pitch := 1.0) -> void:
	var s := stream(sound)
	if s == null:
		return
	var p := _pool[_next]
	_next = (_next + 1) % _pool.size()
	p.stream = s
	p.volume_db = vol_db
	p.pitch_scale = pitch
	p.play()


func play_at(sound: String, pos: Vector3, vol_db := 0.0) -> void:
	var s := stream(sound)
	if s == null:
		return
	var p := _pool3d[_next3d]
	_next3d = (_next3d + 1) % _pool3d.size()
	p.stream = s
	p.volume_db = vol_db
	p.global_position = pos
	p.play()


func ui(sound: String) -> void:
	play(sound, -6.0)


func music(track: String) -> void:
	if track == _music_name:
		return
	_music_name = track
	var s := stream("music_" + track)
	if s == null:
		_music.stop()
		return
	_music.stream = s
	_music.volume_db = -4.0
	_music.play()
