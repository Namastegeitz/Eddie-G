static func get_def(id: String) -> Dictionary:
	if DEFS.has(id):
		return DEFS[id]
	return NEW_DEFS.get(id, DEFS["ceres"])


static func has(id: String) -> bool:
	return DEFS.has(id) or NEW_DEFS.has(id)


