guide = PackedStringArray("primary|Shell up (hold): nothing can hurt you, but you can\'t move", "jump|Hop - hold it in the air to flutter down gently", "secondary|Squeeze into gaps", "dodge|Dash", "sense|Antennae: point to the nearest crumb", "tip|Lucky: people won\'t swat a ladybug until the alarm is full. Pets don\'t care.")
rating_stealth = 0.4
rating_toughness = 0.85
max_hits = 2
knockdown_time = 0.6
move_speed = 5.5
sprint_speed = 5.5
visibility_mult = 1.15
noise_mult = 0.7
camo_tags = PackedStringArray("leaves")
gap_crawler = true
ability_duration = 3.0
