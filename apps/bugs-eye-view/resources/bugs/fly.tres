tagline = "Buzzing, darting, hovering - the whole room is yours."
guide = PackedStringArray("move|Push into a wall, cupboard or table leg to climb it; walk over the top onto it", "jump|Take off, and fly up", "secondary|Fly down, land, or cling to a wall or ceiling", "primary|Boost: faster, but tiring", "dodge|Burst sideways (twice quickly to loop, with Down to dive); hold to fly faster", "interact|Pester a person or pet by their head", "sense|Slow motion (kicks in by itself when a swat is coming)", "tip|Let go to hover. Warm air over the stove and lamps refills your wings.")
