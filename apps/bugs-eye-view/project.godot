; Engine configuration file.
; Bug's-Eye View — action-stealth survival as a tiny household bug.

config_version=5

[application]

config/name="Bug's-Eye View"
config/description="Survive a busy human home as a tiny bug: sneak, scavenge, escape."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.035, 0.03, 1)
boot_splash/image="res://assets/icons/splash.png"
config/icon="res://assets/icons/icon.png"

[autoload]

SaveSystem="*res://autoload/save_system.gd"
InputRouter="*res://autoload/input_router.gd"
AudioManager="*res://autoload/audio_manager.gd"
Feedback="*res://autoload/feedback.gd"
HouseClock="*res://autoload/house_clock.gd"
PerceptionSystem="*res://autoload/perception_system.gd"
GameManager="*res://autoload/game_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor]

; Ship scenes as text: the binary conversion drops packed-array overrides on
; instanced actors (routes, routine event lists) in this Godot version.
export/convert_text_resources_to_binary=false

[input_devices]

pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="threat"
3d_physics/layer_4="hazard"
3d_physics/layer_5="pickup"
3d_physics/layer_6="prop"
3d_physics/layer_7="zone"
3d_physics/layer_8="web"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=30.0
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.05, 1)
